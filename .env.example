# Copy to .env and fill in. Never commit .env. Values below are blank or safe defaults.

# Model. The key is sent in the x-goog-api-key header, never in a URL.
GEMINI_API_KEY=
GEMINI_MODEL=

# PageSpeed Insights and Chrome UX Report. Optional. A missing key does not fail a job.
GOOGLE_API_KEY=

# GitHub REST. Used to clone, push a branch, and open a pull request. Never used to merge.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
DEMO_REPO_OWNER=
DEMO_REPO_NAME=

# Postgres connection string. Required.
DATABASE_URL=

# Session cookie signing and the single shared login password. Required.
SESSION_SECRET=
ADMIN_PASSWORD=

# Shared secret for /api/internal/*. Empty rejects every internal call.
JOB_SECRET=

# Browser origin allowed by CORS, and where notification links point. Required.
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=lax

# Email through Resend. Optional. A missing key skips email.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL_DEFAULT=

# Telegram Bot API. Optional. A missing token skips Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 skips the network and records a dry-run notification.
NOTIFY_DRY_RUN=

# Healthy checks required before monitoring leaves "learning". Default 3.
MONITOR_MIN_HISTORY=3

# 0 turns the in-process scheduler off. Default on.
SCHEDULER_ENABLED=
# Weekly digest. Default Monday 08:00.
DIGEST_CRON=0 8 * * 1

# local unless this is exactly github.
EXECUTOR=
# Public origin GitHub Actions calls back. Falls back to CLIENT_ORIGIN.
PERFPILOT_URL=

# Chrome or Chromium binary. Optional. Playwright's Chromium is used when this is empty.
PERFPILOT_CHROME=

# API port. Default 8080. The demo site uses its own PORT, default 4200.
PORT=8080
NODE_ENV=

# 1 allows private, loopback, and unique-local targets. Link-local and cloud metadata are always rejected.
# Empty uses the default: 1 when NODE_ENV is not production, 0 in production.
ALLOW_PRIVATE_TARGETS=

# Demo site only. 1 injects /regression.js into HTML responses.
DEMO_REGRESSION=

# Screenshot script only.
SCREENSHOT_BASE=http://localhost:5173
SCREENSHOT_FROM=
