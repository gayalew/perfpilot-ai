{
  "name": "@perfpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../.env --import tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file=../.env --import tsx src/migrate.ts",
    "db:check": "node --env-file=../.env --import tsx src/db-check.ts",
    "seed": "node --env-file=../.env --import tsx src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
